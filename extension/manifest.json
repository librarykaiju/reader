{
	"manifest_version": 3,
	"name": "Reader New Tab",
	"version": "1.0",
	"description": "Opens reader.brandonj.ink in every new tab.",
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "reader-newtab@brandonj.ink",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	}
}
